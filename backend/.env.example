# Secret used to sign session tokens. Set a long random value in production.
APP_SECRET=change-me
DATABASE_PATH=adaptivelearn.db
CORS_ORIGINS=http://localhost:5173
# Optional. Without a key the rule-based analyser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 to expose POST /api/demo/seed (sample data only).
DEMO_MODE=1
